rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 🏢 UNIDADES / LAVA-JATOS
    match /unidades/{unidadeId} {
      allow read: if true;
      allow write: if true;
    }

    // 👤 CLIENTES (Cadastro via celular PWA / QR Code e balcão)
    match /clientes/{clienteId} {
      allow read: if true;
      allow write: if true;
    }

    // 📅 AGENDAMENTOS (Agendamento online e fila)
    match /agendamentos/{agendamentoId} {
      allow read: if true;
      allow write: if true;
    }

    // 🖼️ BANNERS PROMOCIONAIS
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // 🏷️ SERVIÇOS E PREÇOS
    match /servicos/{servicoId} {
      allow read: if true;
      allow write: if true;
    }

    // 🔌 TESTE DE CONEXÃO
    match /teste_conexao/{docId} {
      allow read, write: if true;
    }

    // 📋 VISTORIAS E CHECKLISTS COM FOTOS
    match /checklists/{checklistId} {
      allow read, write: if true;
    }

    // 🛑 BLOQUEIO PADRÃO: Impede criação de coleções desconhecidas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}


